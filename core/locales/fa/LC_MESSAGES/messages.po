msgid "Access token refreshed successfully"
msgstr "توکن دسترسی با موفقیت تمدید شد"

msgid "Logged out successfully"
msgstr "با موفقیت خارج شدید"

msgid "User logged in successfully"
msgstr "ورود با موفقیت انجام شد"

msgid "User registered successfully"
msgstr "ثبت‌نام با موفقیت انجام شد"